---
/**
 * Testo GDPR generico (artt. 13-14): va RIVISTO con il cliente. I dati del titolare vengono
 * da src/data/site.ts; se il form usa un servizio esterno (Formspree, Resend…) va citato in Destinatari.
 */
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { site, isSet, mailHref, telHref } from '../data/site';

// Titolare: solo i dati compilati (ragione sociale, P.IVA, PEC ed email si aggiungono da soli).
const titolare = [
  isSet(site.ragioneSociale) ? site.ragioneSociale : site.nome,
  `${site.indirizzo.via}, ${site.indirizzo.cap} ${site.indirizzo.citta} (${site.indirizzo.provincia})`,
  isSet(site.piva) ? `P.IVA ${site.piva}` : null,
  isSet(site.pec) ? `PEC ${site.pec}` : null,
  `tel. ${site.telefono.display}`,
].filter(Boolean).join(' — ');

const crumbs = [{ label: 'Privacy policy' }];
---
<Layout title={`Privacy policy | ${site.nome}`} description={`Informativa sul trattamento dei dati personali degli utenti del sito di ${site.nome}, ai sensi del Regolamento (UE) 2016/679.`} crumbs={crumbs}>
  <PageHead crumbs={crumbs} lead="Informativa ai sensi degli artt. 13 e 14 del Regolamento (UE) 2016/679." leadClass="lead mt-2">Privacy policy</PageHead>
  <section class="section">
    <div class="container narrow prose">
      <h2>Titolare del trattamento</h2>
      <p>{titolare}{isSet(site.email) && <> — email <a href={mailHref()}>{site.email}</a></>}.</p>
      <h2>Dati trattati</h2>
      <p><strong>Dati di navigazione.</strong> I sistemi informatici che gestiscono il sito acquisiscono, nel normale funzionamento, alcuni dati tecnici (indirizzo IP, tipo di browser, data e ora della richiesta) necessari a erogare le pagine e a garantirne la sicurezza.</p>
      <p><strong>Dati forniti volontariamente.</strong> Compilando il modulo di contatto o scrivendo all’indirizzo email dello studio, l’utente fornisce nome, email, eventuale telefono e il contenuto del messaggio.</p>
      <h2>Finalità e base giuridica</h2>
      <ul>
        <li>Rispondere alle richieste di informazioni e di preventivo (misure precontrattuali richieste dall’interessato, art. 6.1.b GDPR).</li>
        <li>Garantire il funzionamento e la sicurezza del sito (legittimo interesse, art. 6.1.f GDPR).</li>
      </ul>
      <h2>Conservazione</h2>
      <p>I dati inviati tramite il modulo sono conservati per il tempo necessario a gestire la richiesta e, se ne nasce un incarico, per la durata prevista dagli obblighi di legge.</p>
      <h2>Destinatari</h2>
      <p>I dati sono trattati dal personale dello studio e dai fornitori tecnici che ospitano il sito e gestiscono l’invio dei moduli (Netlify), nominati responsabili del trattamento. I dati non sono diffusi né ceduti a terzi per finalità di marketing.</p>
      <h2>Diritti dell’interessato</h2>
      <p>È possibile chiedere in qualsiasi momento l’accesso ai propri dati, la rettifica, la cancellazione, la limitazione o l’opposizione al trattamento e la portabilità, {isSet(site.email) ? <>scrivendo a <a href={mailHref()}>{site.email}</a></> : <>contattando il titolare al <a href={telHref()}>{site.telefono.display}</a></>}. È inoltre possibile proporre reclamo al Garante per la protezione dei dati personali.</p>
      <h2>Cookie</h2>
      <p>Per l’uso dei cookie si rimanda alla <a href="/cookie-policy/">cookie policy</a>.</p>
    </div>
  </section>
</Layout>
