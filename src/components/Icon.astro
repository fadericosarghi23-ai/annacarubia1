---
import { icone, type NomeIcona } from '../data/icone';

interface Props {
  name: NomeIcona;
  class?: string;
}
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icone[name]} />
