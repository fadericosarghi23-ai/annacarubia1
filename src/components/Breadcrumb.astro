---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav aria-label="Percorso">
  <ol class="breadcrumb">
    <li><a href="/">Home</a></li>
    {items.map((it) => (
      <li>{it.href ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}</li>
    ))}
  </ol>
</nav>
