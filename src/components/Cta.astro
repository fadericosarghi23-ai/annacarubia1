---
/**
 * Blocco CTA rosso in fondo alle pagine.
 * Il segno decorativo .gmark (416×416, angolo in basso a destra) nel sito di partenza era
 * il marchio del cliente: qui è un riquadro neutro con le stesse misure.
 * [[DA COMPILARE: segno grafico del marchio del cliente, path SVG su viewBox 64×64, solo contorno]]
 */
import { telHref, site } from '../data/site';
import { cta } from '../data/contenuti';
---
<section class="cta section-sm">
  <svg class="gmark" width="416" height="416" viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M62.5 1.5H1.5v61h61z" stroke="currentColor" stroke-width="3" stroke-linecap="square"></path></svg>
  <div class="container">
    <div class="narrow reveal">
      <p class="eyebrow-light mb-2">Contatti</p>
      <h2 class="h2">{cta.titolo}</h2>
      <p class="lead mt-2" style="color: rgb(255 255 255 / 0.88)">{cta.testo}</p>
      <div class="btn-row mt-4">
        <a href="/contatti/#richiesta" class="btn btn-primary">Richiedi un preventivo</a>
        <a href={telHref()} class="btn btn-outline-light">Chiama lo {site.telefono.display}</a>
      </div>
    </div>
  </div>
</section>
