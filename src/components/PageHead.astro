---
/** Testata chiara su fondo sabbia (header pieno). */
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  crumbs?: { label: string; href?: string }[];
  eyebrow?: string;
  lead?: string;
  leadClass?: string;
  h1Style?: string;
}
const { crumbs, eyebrow, lead, leadClass = 'lead mt-3 narrow', h1Style } = Astro.props;
---
<section class="page-head bg-sand">
  <div class="container">
    {crumbs && <Breadcrumb items={crumbs} />}
    {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
    <h1 class="h1-page" style={h1Style}><slot /></h1>
    {lead && <p class={leadClass}>{lead}</p>}
  </div>
</section>
