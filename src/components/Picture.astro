---
/**
 * <picture> come nel sito di partenza: avif + webp + jpg con srcset, oppure (segnaposto o
 * file singolo) solo l'<img>. width/height sono SEMPRE le misure intrinseche dell'immagine.
 */
import { imgSrc, srcset, type Img } from '../lib/media';

interface Props {
  img: Img;
  sizes?: string;
  eager?: boolean;
  class?: string;
  alt?: string;
}
const { img, sizes = '100vw', eager = false, class: cls, alt } = Astro.props;
const avif = srcset(img, 'avif');
const webp = srcset(img, 'webp');
---
<picture>{avif && <source type="image/avif" srcset={avif} sizes={sizes} />}{webp && <source type="image/webp" srcset={webp} sizes={sizes} />}<img src={imgSrc(img)} alt={alt ?? img.alt} width={img.width} height={img.height} loading={eager ? 'eager' : 'lazy'} decoding={eager ? 'sync' : 'async'} fetchpriority={eager ? 'high' : 'auto'} class={cls} /></picture>
